# Copy this file to .env and edit. Never commit the real .env.
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Kathmandu

# Only needed once DJANGO_DEBUG=False and you want contact emails delivered.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=you@gmail.com
